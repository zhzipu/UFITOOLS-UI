<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件 4x1：单行状态条。
  顺序 = 优先级：信号柱 / 制式 / 今日流量（吃掉剩余宽度） / 温度·电量 / 刷新。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_bar1"
            android:layout_width="3dp"
            android:layout_height="4dp"
            android:background="@color/widget_bar_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_bar2"
            android:layout_width="3dp"
            android:layout_height="7dp"
            android:layout_marginStart="2dp"
            android:background="@color/widget_bar_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_bar3"
            android:layout_width="3dp"
            android:layout_height="10dp"
            android:layout_marginStart="2dp"
            android:background="@color/widget_bar_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_bar4"
            android:layout_width="3dp"
            android:layout_height="13dp"
            android:layout_marginStart="2dp"
            android:background="@color/widget_bar_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_bar5"
            android:layout_width="3dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:background="@color/widget_bar_off"
            android:contentDescription="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_nettype"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/widget_placeholder_short"
        android:textColor="@color/widget_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 运营商品牌标识：运行时由 setImageViewResource 换成实际那一家 -->
    <ImageView
        android:id="@+id/widget_carrier"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_carrier_generic" />

    <TextView
        android:id="@+id/widget_day"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_placeholder_day"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_placeholder_meta"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/widget_action_refresh"
        android:padding="3dp"
        android:src="@drawable/ic_widget_refresh" />
</LinearLayout>
